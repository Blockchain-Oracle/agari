# Agari root environment (names only). Copy to .env.local and fill in; never commit values.
# Used by scripts/ (key probe, price archivers, deploy scripts). `pnpm env:check` shows what is set.
# web/.env.local and services/ops/.env.local hold each app's own copy (see their .env.example files).

# Pyth trial (Hermes, server-only). Trial covers TSLA/QQQ/VOO equities until about 2026-09-27.
PYTH_API_KEY=

# Alpaca paper account: NYSE calendar/clock and IEX bars (server-only)
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub: quotes, market status, earnings, news (server-only)
FINNHUB_API_KEY=

# Helius: devnet RPC and mainnet holdings reads (server-only; the browser goes through /api)
HELIUS_API_KEY=

# Optional: Jupiter Price v3 higher rate limit (token-lane fallback, S6)
JUPITER_API_KEY=

# Optional: Stork (only if the hackathon key request is granted)
STORK_API_KEY=

# RedStone needs no key. Optional override (comma-separated), used by price-relay from S3:
# REDSTONE_GATEWAY_URLS=https://oracle-gateway-2.a.redstone.finance

# The proxy in front of this deployment, so IP-metered surfaces (faucet, proof replay) can believe a header:
# cloudflare | forwarded | vercel. Unset in production = those surfaces refuse every visitor, honestly.
TRUSTED_PROXY=
