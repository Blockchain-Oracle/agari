# The web deploy uploads the workspace, so everything the build does not read stays out of it.
# Without this the upload is ~13 GB: anchor/ alone is 6.5 GB of Rust build output and web/.next
# is another 5 GB of a local production build Vercel rebuilds from source anyway.
# Nothing under web/src, packages/*/src or services/ops/src imports anchor/, so it goes whole.
anchor
web/.next
data
live
docs
context
reference
reference-sources
refs
.claude
.review
.21st
.codex
.agents
.cursor
.windsurf
.surfpool
_bmad
_bmad-output
