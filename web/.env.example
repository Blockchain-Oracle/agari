# Copy to web/.env.local. Keep real keys and private values out of Git.
# Public values are bundled into the browser; never put a credential in NEXT_PUBLIC_*.

# Local app and data sources. The app has devnet defaults for the Solana URLs.
DATABASE_URL=postgres://localhost:5432/agari
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_AGARI_INDEXER_URL=/api/index
NEXT_PUBLIC_PRICE_FEED_URL=http://localhost:8787
# AGARI_INDEXER_INTERNAL_URL=http://127.0.0.1:3000/api/index
HELIUS_API_KEY=
FINNHUB_API_KEY=

# Public links and social cards.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=https://docs.useagari.xyz
# NEXT_PUBLIC_X_HANDLE=

# Program-address overrides. The checked-in address registry supplies the usual values.
# NEXT_PUBLIC_AGARI_VAULT_PROGRAM_ID=
# NEXT_PUBLIC_AGARI_DESK_PROGRAM_ID=
DESK_OPERATOR_ADDRESS=
STRATEGY_RUNNER_ADDRESS=

# AI replies and paper-desk decisions. Set one provider key, or use a compatible endpoint.
AI_MODEL=openai/gpt-5.4
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_BASE_URL=
# AI_API_KEY=

# Optional fee sponsorship and devnet faucets.
# SPONSOR_PRIVATE_KEY=
# SPONSOR_RPC_URL=
# FAUCET_MINT_AUTHORITY_PRIVATE_KEY=
SOL_FAUCET_ENABLED=false
# SOL_FAUCET_PRIVATE_KEY=
# SOL_FAUCET_RPC_URL=
# TRUSTED_PROXY=cloudflare

# X sign-in and game rooms. Use the same ROOM_TOKEN_SECRET in web and ops.
# X_API_KEY=
# X_API_KEY_SECRET=
# X_REDIRECT_URI=
# X_SESSION_SECRET=
# X_EXECUTOR_ADDRESS=
# ROOM_TOKEN_SECRET=
# GAME_ROOM_PUBLIC_URL=ws://localhost:8787

# Optional season, leaderboard, and share settings.
# SEASON_ID=
# SEASON_NAME=
# SEASON_ENDS_AT=
# SEASON_PRIZE_SPLIT=
# SEASON_MIN_STAKED_DUELS=
# SEASON_ELIGIBILITY_NOTE=
# AGARI_OPERATOR_WALLETS=
