# Agari ops environment (names only). Copy to services/ops/.env.local; never commit values.
# One Fly machine in production; one writer per key (P§4). `pnpm env:check` shows what is set.

DATABASE_URL=postgres://localhost:5432/agari
HELIUS_API_KEY=

# price-relay (S3)
PYTH_API_KEY=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
# REDSTONE_GATEWAY_URLS=https://oracle-gateway-2.a.redstone.finance
# SWITCHBOARD_CROSSBAR_URL=https://crossbar.switchboard.xyz   (S6; public endpoint is rate-limited)

# Role keys (devnet). Keypair files live in ~/.config/agari/devnet/<role>.json.
ROLLER_PRIVATE_KEY=
PRICE_RELAY_PRIVATE_KEY=
PRICE_ATTESTOR_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
MAKER_PRIVATE_KEY=
RUNNER_PRIVATE_KEY=
LEVERAGE_KEEPER_PRIVATE_KEY=
PRIVATE_DESK_PRIVATE_KEY=
X_EXECUTOR_PRIVATE_KEY=
GAME_DECK_PRIVATE_KEY=
GAME_SETTLER_PRIVATE_KEY=
SEASON_ADMIN_PRIVATE_KEY=

# Agents (S9) and X relay (S11)
OPENAI_API_KEY=
AI_MODEL=openai/gpt-5.4
X_HANDLE=
X_RETTIWT_API_KEY=

# Games (S12b)
GAME_DECK_KEY=
ROOM_TOKEN_SECRET=
